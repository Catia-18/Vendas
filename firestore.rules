rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'province', 'municipality', 'address', 'quantity', 'total', 'paymentMethod', 'orderStatus'])
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 50
        && data.total is number && data.total >= 0
        && data.orderStatus in ['new', 'awaiting_confirmation', 'confirmed', 'preparing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['id', 'name', 'location', 'rating', 'title', 'comment'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 2000;
    }

    // Products collection: public read, authenticated/admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Delivery zones collection: public read, authenticated/admin write
    match /delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Store settings: public read, authenticated/admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer testimonials: public read, validated create, auth write for update/delete
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isValidId(testimonialId) && isValidTestimonial(request.resource.data);
      allow update, delete: if request.auth != null;
    }

    // Customer orders: create allowed for checkout, get allowed for tracking, admin can manage
    match /orders/{orderId} {
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow get: if isValidId(orderId);
      allow list, update, delete: if request.auth != null;
    }
  }
}
